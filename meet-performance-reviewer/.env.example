# Claude API Configuration
ANTHROPIC_API_KEY=your_claude_api_key_here

# Email Configuration
EMAIL_TO=your.email@newpublic.org
EMAIL_FROM=your.email@newpublic.org

# Google Drive Configuration (leave empty to use interactive OAuth)
# GOOGLE_CLIENT_ID=your_client_id
# GOOGLE_CLIENT_SECRET=your_client_secret
# GOOGLE_REFRESH_TOKEN=your_refresh_token

# Review Schedule (cron format: minute hour day month weekday)
# Default: Every Monday at 9 AM
SCHEDULE_CRON=0 9 * * 1

# Review Period (in days, default: 7 for weekly)
REVIEW_PERIOD_DAYS=7

# Optional: Filter to specific email for meetings you organized/attended
YOUR_EMAIL=your.email@newpublic.org
